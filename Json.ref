/**
<Json-Parse s.CHAR*> == Success t.Json | Fails s.Line s.Col e.Error

t.Json ::= t.Value
t.Value ::=
    t.Object | t.Array |
    t.String | t.Number |
    True | False | Null

t.Object ::= (Object (t.String t.Value)*)
t.Array ::= (Array t.Value*)
t.String ::= (String s.CHAR*)
t.Number ::= (Number (s.Integer) (s.Fraction?) (s.Exponent?))
s.Integer ::= '-'? s.NUMBER
s.Fraction ::= '-'? s.NUMBER
s.Exponent ::= '-'? s.NUMBER

s.Line ::= s.NUMBER
s.Col ::= s.NUMBER
  s.Line and s.Col count from 1 and point at the first character that could not be parsed.

e.Error ::= s.CHAR*
*/
$ENTRY Json-Parse {
  e.Content = <Json-Parse-SwElement <Parse-Element 1 1 () e.Content>>;
}


/**
<Json-Stringify t.Json> == s.CHAR*
*/
$ENTRY Json-Stringify {
  Null = 'null';

  True = 'true';

  False = 'false';

  (String e.String) = '"' <Escape e.String> '"';

  (Number (e.Integer) (/* empty */) (/* empty */)) = <Symb e.Integer>;

  (Number (e.Integer) (/* empty */) (e.Exponent )) = <Symb e.Integer> 'e' <Symb e.Exponent>;

  (Number (e.Integer) (e.Fraction ) (/* empty */)) = <Symb e.Integer> '.' <Symb e.Fraction>;

  (Number (e.Integer) (e.Fraction ) (e.Exponent )) = <Symb e.Integer> '.' <Symb e.Fraction> 'e' <Symb e.Exponent>;

  (Object e.Members) = '{' <MapJoin Json-Stringify ',' e.Members> '}';

  (Array e.Elements) = '[' <MapJoin Json-Stringify ',' e.Elements> ']';

  (t.Key t.Value) = <Json-Stringify t.Key> ':' <Json-Stringify t.Value>;
}


Json-Parse-SwElement {
  Success s.Line s.Col (t.Element) /* empty */ = Success t.Element;

  Success s.Line s.Col (t.Element) e.Wtf = Fails s.Line s.Col 'Expected end of input after the root value';

  Fails e.Error = Fails e.Error;  
}


Parse-Element {
  s.Line s.Col t.Stack e.Content = <Parse-Element-SwLeadingWs <Parse-Ws s.Line s.Col t.Stack e.Content>>;
}


Parse-Element-SwLeadingWs {
  Success s.Line s.Col t.Stack e.Content = <Parse-Element-SwValue <Parse-Value s.Line s.Col t.Stack e.Content>>;

  Fails e.Error = Fails e.Error;
}


Parse-Element-SwValue {
  Success s.Line s.Col t.Stack e.Content = <Parse-Element-SwTrailingWs <Parse-Ws s.Line s.Col t.Stack e.Content>>;

  Fails e.Error = Fails e.Error;
}


Parse-Element-SwTrailingWs {
  Success s.Line s.Col t.Stack e.Content = Success s.Line s.Col t.Stack e.Content;

  Fails e.Error = Fails e.Error;
}


Parse-Value {
  s.Line s.Col t.Stack '{' e.Content = <Parse-Object s.Line s.Col t.Stack '{' e.Content>;

  s.Line s.Col t.Stack '[' e.Content = <Parse-Array s.Line s.Col t.Stack '[' e.Content>;

  s.Line s.Col t.Stack '"' e.Content = <Parse-String s.Line s.Col t.Stack '"' e.Content>;

  s.Line s.Col t.Stack s.Char e.Content
    , <IsFirstNumberChar s.Char> : True
    = <Parse-Number s.Line s.Col t.Stack s.Char e.Content>;

  s.Line s.Col (e.Stack) 'true' e.Content = <Parse-True s.Line s.Col (e.Stack) 'true' e.Content>;

  s.Line s.Col (e.Stack) 'false' e.Content = <Parse-False s.Line s.Col (e.Stack) 'false' e.Content>;

  s.Line s.Col (e.Stack) 'null' e.Content = <Parse-Null s.Line s.Col (e.Stack) 'null' e.Content>;

  s.Line s.Col t.Stack e.Content = Fails s.Line s.Col 'Expected a value';
}


Parse-Object {
  s.Line s.Col (e.Stack) '{' e.Content = <Parse-Object-SwLeadingWs <Parse-Ws s.Line <Inc s.Col> (e.Stack (/* empty */)) e.Content>>;
}


Parse-Object-SwLeadingWs {
  Success s.Line s.Col (e.Stack (/* empty */)) '}' e.Content = Success s.Line <Inc s.Col> (e.Stack (Object /* empty */)) e.Content;

  Success s.Line s.Col t.Stack e.Content = <Parse-Object-SwMembers <Parse-Members s.Line s.Col t.Stack e.Content>>;

  Fails e.Error = Fails e.Error;
}


Parse-Object-SwMembers {
  Success s.Line s.Col (e.Stack (e.Members)) '}' e.Content = Success s.Line <Inc s.Col> (e.Stack (Object e.Members)) e.Content;

  Success s.Line s.Col t.Stack e.Content = Fails s.Line s.Col 'Expected \'}\' at the end of an object';

  Fails e.Error = Fails e.Error;
}


Parse-Members {
  s.Line s.Col t.Stack e.Content = <Parse-Members-SwMember <Parse-Member s.Line s.Col t.Stack e.Content>>;
}


Parse-Members-SwMember {
  Success s.Line s.Col (e.Stack (e.Members) t.Member) ',' e.Content 
    = <Parse-Members s.Line <Inc s.Col> (e.Stack (e.Members t.Member)) e.Content>;

  Success s.Line s.Col (e.Stack (e.Members) t.Member) e.Content = Success s.Line s.Col (e.Stack (e.Members t.Member)) e.Content;

  Fails e.Error = Fails e.Error;
}


Parse-Member {
  s.Line s.Col t.Stack e.Content = <Parse-Member-SwLeadingWs <Parse-Ws s.Line s.Col t.Stack e.Content>>;
}


Parse-Member-SwLeadingWs {
  Success s.Line s.Col t.Stack e.Content = <Parse-Member-SwKey <Parse-String s.Line s.Col t.Stack e.Content>>;

  Fails e.Error = Fails e.Error;
}


Parse-Member-SwKey {
  Success s.Line s.Col t.Stack e.Content = <Parse-Member-SwTrailingWs <Parse-Ws s.Line s.Col t.Stack e.Content>>;

  Fails e.Error = Fails e.Error;
}


Parse-Member-SwTrailingWs {
  Success s.Line s.Col t.Stack ':' e.Content = <Parse-Member-SwElement <Parse-Element s.Line <Inc s.Col> t.Stack e.Content>>;

  Success s.Line s.Col t.Stack e.Content = Fails s.Line s.Col 'Expected \':\' after an object key';

  Fails e.Error = Fails e.Error;
}


Parse-Member-SwElement {
  Success s.Line s.Col (e.Stack t.String t.Value) e.Content = Success s.Line s.Col (e.Stack (t.String t.Value)) e.Content;

  Fails e.Error = Fails e.Error;
}


Parse-Array {
  s.Line s.Col (e.Stack) '[' e.Content = <Parse-Array-SwLeadingWs <Parse-Ws s.Line <Inc s.Col> (e.Stack (/* empty */)) e.Content>>;
}


Parse-Array-SwLeadingWs {
  Success s.Line s.Col (e.Stack (/* empty */)) ']' e.Content = Success s.Line <Inc s.Col> (e.Stack (Array /* empty */)) e.Content;

  Success s.Line s.Col t.Stack e.Content = <Parse-Array-SwElements <Parse-Elements s.Line s.Col t.Stack e.Content>>;

  Fails e.Error = Fails e.Error;
}


Parse-Array-SwElements {
  Success s.Line s.Col (e.Stack (e.Elements)) ']' e.Content = Success s.Line <Inc s.Col> (e.Stack (Array e.Elements)) e.Content;

  Success s.Line s.Col t.Stack e.Content = Fails s.Line s.Col 'Expected \']\' at the end of an array';

  Fails e.Error = Fails e.Error;
}


Parse-Elements {
  s.Line s.Col t.Stack e.Content = <Parse-Elements-SwElement <Parse-Element s.Line s.Col t.Stack e.Content>>;
}


Parse-Elements-SwElement {
  Success s.Line s.Col (e.Stack (e.Elements) t.Element) ',' e.Content
    = <Parse-Elements s.Line <Inc s.Col> (e.Stack (e.Elements t.Element)) e.Content>;

  Success s.Line s.Col (e.Stack (e.Elements) t.Element) e.Content = Success s.Line s.Col (e.Stack (e.Elements t.Element)) e.Content;

  Fails e.Error = Fails e.Error;
}


Parse-String {
  s.Line s.Col (e.Stack) '"' e.Content
    = <Parse-String-SwCharacters <Parse-Characters s.Line <Inc s.Col> (e.Stack (/* empty */)) e.Content>>;

  s.Line s.Col t.Stack e.Content = Fails s.Line s.Col 'Expected \'"\' at the beginning of a string';
}


Parse-String-SwCharacters {
  Success s.Line s.Col (e.Stack (e.Characters)) '"' e.Content = Success s.Line <Inc s.Col> (e.Stack (String e.Characters)) e.Content;

  Success s.Line s.Col t.Stack e.Content = Fails s.Line s.Col 'Expected \'"\' at the end of a string';

  Fails e.Error = Fails e.Error;
}


Parse-Characters {
  s.Line s.Col t.Stack '"' e.Content = Success s.Line s.Col t.Stack '"' e.Content;

  s.Line s.Col t.Stack e.Content = <Parse-Characters-SwCharacter <Parse-Character s.Line s.Col t.Stack e.Content>>;
}


Parse-Characters-SwCharacter {
  Success s.Line s.Col (e.Stack (e.Characters) s.Character) e.Content
    = <Parse-Characters s.Line s.Col (e.Stack (e.Characters s.Character)) e.Content>;

  Fails e.Error = Fails e.Error;
}


Parse-Character {
  s.Line s.Col t.Stack s.Char e.Content
    , <Compare <Ord s.Char> <Ord '\x20'>> : '-'
    = Fails s.Line s.Col 'Character is outside the permitted range U+0020-U+10FFFF';

  s.Line s.Col t.Stack '"' e.Content = Fails s.Line s.Col 'Unescaped \'"\' in a string';

  s.Line s.Col (e.Stack) '\\u' s.U3 s.U2 s.U1 s.U0 e.Content
    = Success s.Line <Add 6 s.Col> (e.Stack <Chr <Hex2Numb s.U3 s.U2 s.U1 s.U0>>) e.Content;

  s.Line s.Col (e.Stack) '\\u' e.Content = Fails s.Line s.Col 'Expected 4 hex digits after \'\\u\'';

  s.Line s.Col (e.Stack) '\\' s.Char e.Content = Success s.Line <Add 2 s.Col> (e.Stack <Unescape s.Char>) e.Content;

  s.Line s.Col (e.Stack) s.Char e.Content = Success s.Line <Inc s.Col> (e.Stack s.Char) e.Content;
}


Parse-Number {
  s.Line s.Col t.Stack e.Content = <Parse-Number-SwInteger <Parse-Integer s.Line s.Col t.Stack e.Content>>;
}


Parse-Number-SwInteger {
  Success s.Line s.Col t.Stack e.Content = <Parse-Number-SwFraction <Parse-Fraction s.Line s.Col t.Stack e.Content>>;

  Fails e.Error = Fails e.Error;
}


Parse-Number-SwFraction {
  Success s.Line s.Col t.Stack e.Content = <Parse-Number-SwExponent <Parse-Exponent s.Line s.Col t.Stack e.Content>>;

  Fails e.Error = Fails e.Error;
}


Parse-Number-SwExponent {
  Success s.Line s.Col (e.Stack (e.Integer) (e.Fraction) (e.Exponent)) e.Content
    = Success s.Line s.Col (e.Stack (Number (<Numb e.Integer>) <NumbOptional e.Fraction> <NumbOptional e.Exponent>)) e.Content;

  Fails e.Error = Fails e.Error;
}


Parse-Integer {
  s.Line s.Col (e.Stack) '-' '0' e.Content = Success s.Line <Add 2 s.Col> (e.Stack ('-' '0')) e.Content;

  s.Line s.Col (e.Stack) '-' e.Content = <Parse-Digits s.Line <Inc s.Col> (e.Stack ('-')) e.Content>;

  s.Line s.Col (e.Stack) '0' e.Content = Success s.Line <Inc s.Col> (e.Stack ('0')) e.Content;

  s.Line s.Col (e.Stack) e.Content = <Parse-Digits s.Line s.Col (e.Stack (/* empty */)) e.Content>;
}


Parse-Fraction {
  s.Line s.Col (e.Stack) '.' s.Char e.Content, <Type s.Char> : 'D' e.1
    = <Parse-Digits s.Line <Inc s.Col> (e.Stack (/* empty */)) s.Char e.Content>;

  s.Line s.Col (e.Stack) e.Content = Success s.Line s.Col (e.Stack (/* empty */)) e.Content;
}


Parse-Exponent {
  s.Line s.Col (e.Stack) s.E '+' e.Content, <Upper s.E> : 'E'
    = <Parse-Digits s.Line <Inc s.Col> (e.Stack ('+')) e.Content>;

  s.Line s.Col (e.Stack) s.E '-' e.Content, <Upper s.E> : 'E'
    = <Parse-Digits s.Line <Inc s.Col> (e.Stack ('-')) e.Content>;

  s.Line s.Col (e.Stack) s.E s.Char e.Content, <Upper s.E> : 'E', <Type s.Char> : 'D' e.1
    = <Parse-Digits s.Line s.Col (e.Stack (/* empty */)) s.Char e.Content>;

  s.Line s.Col (e.Stack) e.Content = Success s.Line s.Col (e.Stack (/* empty */)) e.Content;
}


Parse-Digits {
  s.Line s.Col (e.Stack (e.Digits)) s.Char e.Content, <Type s.Char> : 'D' e.1
    = <Parse-Digits s.Line <Inc s.Col> (e.Stack (e.Digits s.Char)) e.Content>;

  s.Line s.Col (e.Stack (/* empty */)) e.Content = Fails s.Line s.Col 'Expected a digit';

  s.Line s.Col t.Stack e.Content = Success s.Line s.Col t.Stack e.Content;
}


Parse-True {
  s.Line s.Col (e.Stack) 'true' e.Content = Success s.Line <Add 4 s.Col> (e.Stack True) e.Content;
}


Parse-False {
  s.Line s.Col (e.Stack) 'false' e.Content = Success s.Line <Add 5 s.Col> (e.Stack False) e.Content;
}


Parse-Null {
  s.Line s.Col (e.Stack) 'null' e.Content = Success s.Line <Add 4 s.Col> (e.Stack Null) e.Content;
}


Parse-Ws {
  s.Line s.Col t.Stack ' '    e.Content = <Parse-Ws s.Line <Inc s.Col> t.Stack e.Content>;
  s.Line s.Col t.Stack '\t'   e.Content = <Parse-Ws s.Line <Inc s.Col> t.Stack e.Content>;
  s.Line s.Col t.Stack '\r\n' e.Content = <Parse-Ws <Inc s.Line> 1 t.Stack e.Content>;
  s.Line s.Col t.Stack '\r'   e.Content = <Parse-Ws <Inc s.Line> 1 t.Stack e.Content>;
  s.Line s.Col t.Stack '\n'   e.Content = <Parse-Ws <Inc s.Line> 1 t.Stack e.Content>;
  s.Line s.Col t.Stack        e.Content = Success s.Line s.Col t.Stack e.Content;
}


Inc {
  s.A = <Add 1 s.A>;
}


IsFirstNumberChar {
  '-' = True;

  s.Char, <Type s.Char> : 'D' e.1 = True;

  s.Char = False;
}


Unescape {
  'b' = '\x08';
  'f' = '\x0C';
  'n' = '\n';
  'r' = '\r';
  't' = '\t';
  s.Char = s.Char;
}


Hex2Numb {
  e.Hex = <Do-Hex2Numb 0 e.Hex>;
}


Do-Hex2Numb {
  s.Int s.H e.Hex
    , <Type s.H> : 'D' e.1
    = <Do-Hex2Numb <Add <Mul 16 s.Int> <Numb s.H>> e.Hex>;

  s.Int s.H e.Hex
    , <Upper s.H> : s.UH
    , ('A' 10) ('B' 11) ('C' 12) ('D' 13) ('E' 14) ('F' 15)
    : e.H-B (s.UH s.Value) e.H-E
    = <Do-Hex2Numb <Add <Mul 16 s.Int> s.Value> e.Hex>;

  s.Int = s.Int;
}


MapJoin {
  t.Func s.Del /* empty */ = /* empty */;
  t.Func s.Del t.Item = <Mu t.Func t.Item>;
  t.Func s.Del t.Item e.Items = <Mu t.Func t.Item> s.Del <MapJoin t.Func s.Del e.Items>;
}


Escape {
  '"' e.String = '\\"' <Escape e.String>;
  '\\' e.String = '\\\\' <Escape e.String>;
  '/' e.String = '\\/' <Escape e.String>;
  '\x08' e.String = '\\b' <Escape e.String>;
  '\x0C' e.String = '\\f' <Escape e.String>;
  '\n' e.String = '\\n' <Escape e.String>;
  '\r' e.String = '\\r' <Escape e.String>;
  '\t' e.String = '\\t' <Escape e.String>;
  s.Char e.String = s.Char <Escape e.String>;
  /* empty */ = /* empty */;
}


NumbOptional {
  /* empty */ = (/* empty */);
  e.Numb = (<Numb e.Numb>);
}

/**
Results of Json-Parse for objects: member order, duplicate keys, nesting and structural errors.
Eq compares the expected result in brackets with the actual result.
*/

*$FROM Json
$EXTERN Json-Parse;

$ENTRY Go {
  = <Eq (Success (Object)) <Json-Parse '{}'>>
    <Eq (Success (Object)) <Json-Parse ' \t{\r\n }\n'>>
    <Eq (Success (Object ((String '') Null))) <Json-Parse '{"":null}'>>
    <Eq
      (Success (Object ((String 'b') True) ((String 'a') False) ((String 'b') Null)))
      <Json-Parse '{ "b" : true, "a" : false, "b" : null }'>
    >
    <Eq
      (Success (Object ((String 'a') True) ((String 'a') False)))
      <Json-Parse '{"a":true,"\\u0061":false}'>
    >
    <Eq
      (Success (Object ((String 'a') (Array (Decimal 1 (0)) (Object))) ((String 'b') (Object ((String 'c') (String 'x'))))))
      <Json-Parse '{"a":[1,{}],"b":{"c":"x"}}'>
    >

    <Eq (Fails 1 2 'Expected \'"\' at the beginning of a string') <Json-Parse '{'>>
    <Eq (Fails 1 2 'Expected \'"\' at the beginning of a string') <Json-Parse '{a:1}'>>
    <Eq (Fails 1 2 'Expected \'"\' at the beginning of a string') <Json-Parse '{1:1}'>>
    <Eq (Fails 1 5 'Expected \':\' after an object key') <Json-Parse '{"a"}'>>
    <Eq (Fails 1 5 'Expected \':\' after an object key') <Json-Parse '{"a"'>>
    <Eq (Fails 1 6 'Expected a value') <Json-Parse '{"a":}'>>
    <Eq (Fails 1 6 'Expected a value') <Json-Parse '{"a":'>>
    <Eq (Fails 1 6 'Expected a value') <Json-Parse '{"a"::1}'>>
    <Eq (Fails 1 7 'Expected \'}\' at the end of an object') <Json-Parse '{"a":1'>>
    <Eq (Fails 1 7 'Expected \'}\' at the end of an object') <Json-Parse '{"a":1]'>>
    <Eq (Fails 1 8 'Expected \'}\' at the end of an object') <Json-Parse '{"a":1 "b":2}'>>
    <Eq (Fails 1 8 'Expected \'"\' at the beginning of a string') <Json-Parse '{"a":1,}'>>
    <Eq (Fails 1 8 'Expected \'"\' at the beginning of a string') <Json-Parse '{"a":1,'>>
    <Eq (Fails 3 3 'Expected \':\' after an object key') <Json-Parse '{\n  "a"\n  true}'>>
    <Eq (Fails 3 3 'Expected a value') <Json-Parse '{\n  "a":\n  }'>>
    <Eq (Fails 3 3 'Expected \'"\' at the beginning of a string') <Json-Parse '{\n  "a":true,\n  }'>>
    <Eq (Fails 1 9 'Expected a value') <Json-Parse '{"a":[1,]}'>>
    <Eq (Fails 1 3 'Expected end of input after the root value') <Json-Parse '{}}'>>;
}

Eq {
  (e.Eq) e.Eq = /* pass */;
}
